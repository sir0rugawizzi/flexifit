# FlexiFit Environment Configuration
# Copy this file to .env and set your values

# Server & Security
PORT=
JWT_SECRET=

# Google Gemini AI (Optional - falls back to sample feedback if empty)
GEMINI_API_KEY=
GEMINI_MODEL=

# Oracle Autonomous Database / ORDS (Optional - leave empty to use local SQLite)
ORDS_BASE_URL=

# Upload limits
MAX_UPLOAD_MB=
