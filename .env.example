# FlexiFit Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
JWT_SECRET=change-me-to-a-random-string

# Anthropic AI (optional – app falls back to sample feedback if empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Oracle ORDS (leave empty to use local SQLite)
ORDS_BASE_URL=

# Upload limits
MAX_UPLOAD_MB=50
