# FlexiFit Environment Configuration
# Copy this file to .env and set your values

# Server & Security
PORT=
JWT_SECRET=

# Google Gemini AI (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=

# Oracle Autonomous Database / ORDS (Optional - leave empty to use local SQLite)
ORDS_BASE_URL=

# Data Seeding (Pilot Mode)
# Set to true to populate the database with fictional pilot users and history
SEED_SAMPLE_DATA=
SEED_PASSWORD=
