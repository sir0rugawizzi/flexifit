# FlexiFit Environment Configuration
# Copy this file to .env and set your values

# Server & Security
PORT=
JWT_SECRET=

# AI Pose & Form Check (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=

# Anthropic AI (Optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Oracle Autonomous Database / ORDS (Optional - leave empty to use local SQLite)
ORDS_BASE_URL=

# Upload limits
MAX_UPLOAD_MB=
